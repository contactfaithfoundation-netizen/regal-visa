# Let's check matching by country name normalized
def norm_name(s):
    if not isinstance(s, str): return ""
    return s.lower().replace('&', 'and').replace(' ', '').replace('-', '').replace("'", "")

df_img_all['norm_name'] = df_img_all['country'].apply(norm_name)
available_vid['norm_name'] = available_vid['destination'].apply(norm_name)

merged_name = pd.merge(available_vid, df_img_all, on='norm_name', how='left')
print("Missing image_url by norm_name:", merged_name['image_url'].isnull().sum())

missing_name = merged_name[merged_name['image_url'].isnull()]
print("Missing by name:", missing_name[['destination', 'code']])


