```python
df_vid = pd.read_csv('atlys_hero_videos.csv')
available_vid = df_vid[df_vid['status'] == 'video_available'].copy()

# Let's inspect country matching
print("Available videos count:", len(available_vid))

# Let's check sheet 'All country cards' or whichever sheet is primary
df_img_all = pd.read_excel('country_card_images.xlsx', sheet_name='All country cards')

# Let's clean country names or use ISO country codes / standard matching if available
# Check if country code can be extracted or matched

# In hero_videos.csv, video URL usually has country code: AF.mp4, DZ.mp4 etc.
import re

def get_code_from_video_url(url):
    match = re.search(r'/([A-Z]{2})\.mp4', str(url))
    if match:
        return match.group(1)
    return None

available_vid['code'] = available_vid['hero_video_url'].apply(get_code_from_video_url)

print("Codes extracted in available videos:", available_vid['code'].notnull().sum(), "out of", len(available_vid))

# Merge on country_code
merged = pd.merge(available_vid, df_img_all, left_on='code', right_on='country_code', how='left')

print("Merged shape:", merged.shape)
print("Missing image_url count:", merged['image_url'].isnull().sum())

# Let's check missing rows if any
missing = merged[merged['image_url'].isnull()]
print("Missing countries:")
print(missing[['destination', 'code', 'hero_video_url']])


```

